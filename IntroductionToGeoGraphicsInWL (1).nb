Cell["\<\
Get the flight paths for today\[CloseCurlyQuote]s flights between New York \
and Los Angeles:\
\>", "Text",
 CellChangeTimes->{{3.9803159431914215`*^9, 
  3.980315949991234*^9}},ExpressionUUID->"a85046b9-1217-4b0b-92ff-\
f49bccb1bbea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"flights", "=", 
   RowBox[{"FlightData", "[", 
    RowBox[{
     RowBox[{
      TemplateBox[{"\"John F. Kennedy International Airport\"", 
        RowBox[{"Entity", "[", 
          RowBox[{"\"Airport\"", ",", "\"JFK\""}], "]"}], 
        "\"Entity[\\\"Airport\\\", \\\"JFK\\\"]\"", "\"airport\""},
       "Entity"], "->", 
      TemplateBox[{"\"Los Angeles International Airport\"", 
        RowBox[{"Entity", "[", 
          RowBox[{"\"Airport\"", ",", "\"KLAX\""}], "]"}], 
        "\"Entity[\\\"Airport\\\", \\\"KLAX\\\"]\"", "\"airport\""},
       "Entity"]}], ",", "\"\<FlightPath\>\"", ",", " ", "Yesterday"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9803159242550907`*^9, 3.980315927874048*^9}},
 CellLabel->"In[3]:=",
 CellID->104324071,ExpressionUUID->"4497ca5d-1606-4e90-ad16-d73dd2e2c7e0"],

Cell["Plot the flight paths:", "Text",ExpressionUUID->"d25ff372-9b2d-4cb8-a4b0-b3a928773e01"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GeoGraphics", "[", 
  RowBox[{"{", 
   RowBox[{
    TemplateBox[<|"color" -> RGBColor[0.8300000000000001, 0, 0]|>,
     "RGBColorSwatchTemplate"], ",", 
    RowBox[{"Line", "/@", "flights"}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->1028005345,ExpressionUUID->"80d9a6f6-e63f-4bbd-a731-1960b3d808a1"],

