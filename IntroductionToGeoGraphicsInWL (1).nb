Cell[TextData[{
 ButtonBox["GeoMarker",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/GeoMarker.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/GeoMarker.html"],
 " is similar to Point, except that it supports icons:"
}], "Text",ExpressionUUID->"8f822a81-e1b1-4c84-955b-7d05ac102277"],

Cell[BoxData[
 RowBox[{"GeoGraphics", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
    RowBox[{"GeoMarker", ",", "\[IndentingNewLine]", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"RandomGeoPosition", "[", 
          TemplateBox[{"\"United States\"", 
            RowBox[{"Entity", "[", 
              RowBox[{"\"Country\"", ",", "\"UnitedStates\""}], "]"}], 
            "\"Entity[\\\"Country\\\", \\\"UnitedStates\\\"]\"", 
            "\"country\""},
           "Entity"], "]"}], ",", "20"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"RandomEntity", "[", 
        RowBox[{"\"\<Icon\>\"", ",", "20"}], "]"}]}], "\[IndentingNewLine]", 
      "}"}]}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"GeoRange", "\[Rule]", 
    TemplateBox[{"\"United States\"", 
      RowBox[{"Entity", "[", 
        RowBox[{"\"Country\"", ",", "\"UnitedStates\""}], "]"}], 
      "\"Entity[\\\"Country\\\", \\\"UnitedStates\\\"]\"", "\"country\""},
     "Entity"]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[61]:=",ExpressionUUID->"42e9ef7e-bfd7-454a-aa74-24ea3a9f14f5"],

Cell[TextData[{
 ButtonBox["Polygon",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Polygon.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Polygon.html"],
 " can be used with a list of GeoPosition instances or an Entity with a \
\[OpenCurlyDoubleQuote]Shape\[CloseCurlyDoubleQuote] property."
}], "Text",ExpressionUUID->"f48570d9-5948-4c95-818c-357202de280e"],

Cell[BoxData[
 RowBox[{"GeoGraphics", "[", "\[IndentingNewLine]", 
  RowBox[{"Polygon", "[", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      TemplateBox[{"\"Chicago\"", 
        RowBox[{"Entity", "[", 
          RowBox[{"\"City\"", ",", 
            RowBox[{"{", 
              
              RowBox[{"\"Chicago\"", ",", "\"Illinois\"", ",", 
                "\"UnitedStates\""}], "}"}]}], "]"}], 
        "\"Entity[\\\"City\\\", {\\\"Chicago\\\", \\\"Illinois\\\", \
\\\"UnitedStates\\\"}]\"", "\"city\""},
       "Entity"], "[", "\"\<Position\>\"", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      TemplateBox[{"\"New York City\"", 
        RowBox[{"Entity", "[", 
          RowBox[{"\"City\"", ",", 
            RowBox[{"{", 
              
              RowBox[{"\"NewYork\"", ",", "\"NewYork\"", ",", 
                "\"UnitedStates\""}], "}"}]}], "]"}], 
        "\"Entity[\\\"City\\\", {\\\"NewYork\\\", \\\"NewYork\\\", \
\\\"UnitedStates\\\"}]\"", "\"city\""},
       "Entity"], "[", "\"\<Position\>\"", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      TemplateBox[{"\"New Orleans\"", 
        RowBox[{"Entity", "[", 
          RowBox[{"\"City\"", ",", 
            RowBox[{"{", 
              
              RowBox[{"\"NewOrleans\"", ",", "\"Louisiana\"", ",", 
                "\"UnitedStates\""}], "}"}]}], "]"}], 
        "\"Entity[\\\"City\\\", {\\\"NewOrleans\\\", \\\"Louisiana\\\", \
\\\"UnitedStates\\\"}]\"", "\"city\""},
       "Entity"], "[", "\"\<Position\>\"", "]"}]}], "\[IndentingNewLine]", 
    "}"}], "]"}], "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[62]:=",ExpressionUUID->"febb485c-d781-4ce1-9314-85acee2c502b"],

