Cell[TextData[{
 "GeoGraphics is a generic framework that supports all the background and \
projection options of other geo visualizations. It is useful for adding \
graphics primitives, which are inserted ",
 StyleBox["after",
  FontSlant->"Italic"],
 " the map projection has been applied."
}], "Text",ExpressionUUID->"9430535f-00f3-4584-a985-5447855a7621"],

Cell["Plot a red point:", "Text",ExpressionUUID->"be6bd5dc-c2f6-4c8a-86f7-165621e3bbaa"],

Cell[BoxData[
 RowBox[{"GeoGraphics", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Red", ",", 
     RowBox[{"PointSize", "[", "0.05", "]"}], ",", 
     RowBox[{"Point", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GeoRange", "->", "\"\<World\>\""}], ",", "\[IndentingNewLine]", 
   RowBox[{"GeoProjection", "->", "\"\<Orthographic\>\""}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"ddc343c5-ca31-44d4-a5ee-2029dd7d56b3"],

Cell[TextData[{
 "If you already have a geo visualization ready, standard graphics primitives \
can be added with ",
 ButtonBox["Show",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Show.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Show.html"],
 " (again, post map projection):"
}], "Text",ExpressionUUID->"cf143a04-86af-4597-b61e-9191fe603ff8"],

