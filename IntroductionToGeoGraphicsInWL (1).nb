Cell[TextData[{
 ButtonBox["DayHemisphere",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/DayHemisphere.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/DayHemisphere.html"],
 ", ",
 ButtonBox["NightHemisphere",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/NightHemisphere.html"], 
    None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/NightHemisphere.html"],
 " and ",
 ButtonBox["DayNightTerminator",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/DayNightTerminator.html"], 
    None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/DayNightTerminator.html"],
 " allow you to show areas with daylight at a given time. The default time is \
",
 ButtonBox["Now",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Now.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Now.html"],
 ":"
}], "Text",ExpressionUUID->"e7d63bb8-fe09-4754-a8f6-9516d964efeb"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"GeoGraphics", "[", 
    RowBox[{
     RowBox[{"region", "[", 
      RowBox[{"DatePlus", "[", 
       RowBox[{"Now", ",", " ", 
        RowBox[{"Quantity", "[", 
         RowBox[{"t", ",", " ", "\"\<Hours\>\""}], "]"}]}], "]"}], "]"}], ",", 
     RowBox[{"GeoRange", "\[Rule]", "\"\<World\>\""}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "region", ",", " ", "DayHemisphere", ",", " ", "\"\<Region\>\""}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "DayHemisphere", ",", " ", "NightHemisphere", ",", " ", 
       "DayNightTerminator"}], "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "\"\<Time\>\""}], "}"}], ",", " ",
      "0", ",", " ", "24", ",", " ", "1"}], "}"}], ",", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", 
       StyleBox["\"init\"", "IconizedCustomName", StripOnInput -> False], 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["RuleDelayed", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["392", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Initialization :> GeoGraphics[
      $CellContext`region[
       DatePlus[Now, 
        Quantity[$CellContext`t, "Hours"]]], GeoRange -> "World"],
    SelectWithContents->True,
    Selectable->False]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.93506780596308*^9, 3.93506781834216*^9}, {
   3.9350679450483723`*^9, 3.935067945434531*^9}, {3.935067988428102*^9, 
   3.935067988449943*^9}, {3.935068128588443*^9, 3.9350681636522207`*^9}, {
   3.935068266148233*^9, 3.9350683559515953`*^9}, 3.935068397435904*^9, 
   3.9803164729404545`*^9},
 CellLabel->"In[66]:=",ExpressionUUID->"9bc3fd11-ed94-4a0f-a05c-75b3ae0ac2fb"],

