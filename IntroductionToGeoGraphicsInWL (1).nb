Cell[CellGroupData[{

Cell["Elevation Data", "Subsection",ExpressionUUID->"a1d05ba4-f1f5-4543-8b7d-23a7fe09be86"],

Cell[TextData[{
 "Elevation information, obtained with ",
 ButtonBox["GeoElevationData",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/GeoElevationData.html"], 
    None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/GeoElevationData.html"],
 ", can be shown as contours or as shaded relief textures."
}], "Text",ExpressionUUID->"de9ba474-6f7d-436c-bbcc-10a489ffa270"],

Cell["\<\
Import a Digital Elevation Model (DEM) of Ladybower Reservoir, UK using \
GeoElevationData:\
\>", "Text",
 CellChangeTimes->{{3.9803137303758297`*^9, 3.980313764736723*^9}, {
  3.9803162377876663`*^9, 
  3.980316250770607*^9}},ExpressionUUID->"804d234c-72e2-4561-bc63-\
cfb9e81f0ed0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ladybowerDEM", "=", "\[IndentingNewLine]", 
   RowBox[{"GeoElevationData", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GeoBoundingBox", "[", 
      RowBox[{"GeoDisk", "[", 
       RowBox[{
        TemplateBox[{"\"Ladybower Reservoir\"", 
          RowBox[{"Entity", "[", 
            RowBox[{"\"Lake\"", ",", "\"LadybowerReservoir::83k28\""}], "]"}],
           "\"Entity[\\\"Lake\\\", \\\"LadybowerReservoir::83k28\\\"]\"", 
          "\"lake\""},
         "Entity"], ",", 
        TemplateBox[{"10", "\"km\"", "kilometers", "\"Kilometers\""},
         "Quantity"]}], "]"}], "]"}], ",", "\[IndentingNewLine]", "Automatic",
      ",", "\[IndentingNewLine]", "\"\<GeoPosition\>\"", ",", 
     "\[IndentingNewLine]", 
     RowBox[{"UnitSystem", "->", "\"\<Metric\>\""}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9803136746008167`*^9, 3.980313691298149*^9}, {
  3.980313784447447*^9, 3.980313798477352*^9}, {3.980313954686081*^9, 
  3.9803139612535343`*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"15fd730c-3b33-bd4f-9e01-8dd10abfb711"],

Cell[BoxData[
 RowBox[{"GeoContourPlot", "[", "ladybowerDEM", "]"}]], "Input",
 CellChangeTimes->{{3.9803136974610386`*^9, 3.9803136997083683`*^9}, 
   3.980313972190546*^9},
 CellLabel->"In[14]:=",ExpressionUUID->"42a8af3c-0fb4-4e4c-bc31-c42c976a7075"],

Cell[BoxData[
 RowBox[{"GeoDensityPlot", "[", "\[IndentingNewLine]", 
  RowBox[{"ladybowerDEM", ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
   RowBox[{"GeoBackground", "->", "None"}], ",", 
   RowBox[{"InterpolationOrder", "->", "2"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.9803138358167*^9, 3.980313841616377*^9}, {
  3.9803139990335064`*^9, 3.9803140009572067`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"e899823f-7f74-b44e-8d82-7bf44a92de94"],

Cell[TextData[{
 "For a more dramatic result, you can plot the data (roughly converted to \
Cartesian coordinates) with ",
 ButtonBox["ListPlot3D",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/ListPlot3D.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/ListPlot3D.html"],
 ":"
}], "Text",ExpressionUUID->"9252a624-a2b0-49f5-ac6b-198093e03efd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"elevationData", " ", "=", " ", 
   RowBox[{"GeoElevationData", "[", 
    RowBox[{
     TemplateBox[{"\"Ladybower Reservoir\"", 
       RowBox[{"Entity", "[", 
         RowBox[{"\"Lake\"", ",", "\"LadybowerReservoir::83k28\""}], "]"}], 
       "\"Entity[\\\"Lake\\\", \\\"LadybowerReservoir::83k28\\\"]\"", 
       "\"lake\""},
      "Entity"], ",", 
     RowBox[{"GeoRange", "\[Rule]", 
      TemplateBox[{"4", "\"km\"", "kilometers", "\"Kilometers\""},
       "Quantity"]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.980314053460615*^9, 3.980314071997875*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"19901232-bc39-4109-bf8f-d8e91bf66e05"],

Cell[BoxData[
 RowBox[{"ListPlot3D", "[", 
  RowBox[{
   RowBox[{"Reverse", "[", "elevationData", "]"}], ",", 
   RowBox[{"MeshFunctions", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"#3", "&"}], "}"}]}], ",", 
   RowBox[{"Mesh", "\[Rule]", "30"}]}], "]"}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"22c6b2fa-b897-fc46-82cb-01ae969379ef"],

Cell[TextData[{
 "Do the same for ",
 ButtonBox["Mons Huygens",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Mons_Huygens"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Mons_Huygens"],
 " (the tallest mountain on the Moon), this time setting the geo range \
automatically with ",
 ButtonBox["GeoBoundingBox",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/GeoBoundingBox.html"], 
    None},
  ButtonNote->"http://reference.wolfram.com/language/ref/GeoBoundingBox.html"],
 ":"
}], "Text",ExpressionUUID->"69aa744d-2094-46be-bf24-eb2443368a40"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"GeoElevationData", "[", 
     RowBox[{
      TemplateBox[{"\"Mons Huygens\"", 
        RowBox[{"Entity", "[", 
          RowBox[{"\"SolarSystemFeature\"", ",", "\"MonsHuygensMoon\""}], 
          "]"}], "\"Entity[\\\"SolarSystemFeature\\\", \
\\\"MonsHuygensMoon\\\"]\"", "\"solar system feature\""},
       "Entity"], ",", " ", 
      RowBox[{"GeoRange", " ", "->", " ", 
       RowBox[{"GeoBoundingBox", "[", 
        TemplateBox[{"\"Mons Huygens\"", 
          RowBox[{"Entity", "[", 
            RowBox[{"\"SolarSystemFeature\"", ",", "\"MonsHuygensMoon\""}], 
            "]"}], "\"Entity[\\\"SolarSystemFeature\\\", \
\\\"MonsHuygensMoon\\\"]\"", "\"solar system feature\""},
         "Entity"], "]"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot3D", "[", 
  RowBox[{
   RowBox[{"Reverse", "[", "data", "]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"MeshFunctions", "->", 
    RowBox[{"{", 
     RowBox[{"#3", "&"}], "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", "Gray"}]}], "]"}]}], "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"5bb3a76f-2454-4962-8d24-82669120b01c"],

Cell[TextData[{
 ButtonBox["GeoCircle",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/GeoCircle.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/GeoCircle.html"],
 " can be used to highlight a feature in a map."
}], "Text",ExpressionUUID->"ec6bae48-04ff-450c-887e-7313630fea92"],

Cell["\<\
Plot contour data for the region around Mons Huygens, highlighting the \
mountain itself with a circle:\
\>", "Text",ExpressionUUID->"2ef73c07-170d-496b-aef5-8070e809d2ff"],

Cell[BoxData[
 RowBox[{"GeoGraphics", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"White", ",", " ", "Thick", ",", 
     RowBox[{"GeoCircle", "[", 
      RowBox[{
       TemplateBox[{"\"Mons Huygens\"", 
         RowBox[{"Entity", "[", 
           RowBox[{"\"SolarSystemFeature\"", ",", "\"MonsHuygensMoon\""}], 
           "]"}], "\"Entity[\\\"SolarSystemFeature\\\", \\\"MonsHuygensMoon\\\
\"]\"", "\"solar system feature\""},
        "Entity"], ",", " ", 
       TemplateBox[{"10", "\"km\"", "kilometers", "\"Kilometers\""},
        "Quantity"]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"GeoBackground", "\[Rule]", "\"\<ContourMap\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GeoRange", "\[Rule]", 
    TemplateBox[{"200", "\"km\"", "kilometers", "\"Kilometers\""},
     "Quantity"]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"6c42f852-6253-423b-a7c5-4c2a63ca5dc4"],

Cell[BoxData[""], "EndOfSlide",ExpressionUUID->"db89dde7-340b-40bf-b924-ad1d01cfe2f2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"c6a8f74d-32ba-4a73-b570-7930702b916f"],

Cell[CellGroupData[{

Cell["Map Projections", "Section",
 CellTags->
  "MapProjections",ExpressionUUID->"9714e2d3-91ce-4fe0-bc0a-292b73a2ca94"],

Cell[TextData[{
 "Geo plots are all projections of a 3D sphere (technically an oblate \
spheroid) onto a 2D plane. Different projections can be chosen with the ",
 ButtonBox["GeoProjection",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/GeoProjection.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/GeoProjection.html"],
 " option. In terms of data distortion, the choice of projection makes little \
difference when the scales are small, but can be dramatically different for \
larger scales."
}], "Text",ExpressionUUID->"98467fbe-9667-478a-a085-c8716291e901"],

Cell["\<\
Plot global data with three different projections (the default projection \
depends on the zoom level):\
\>", "Text",ExpressionUUID->"cbbafba9-495f-4a63-8e02-71866bdf0990"],

