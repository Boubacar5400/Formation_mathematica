 " affects computations of coordinates."
}], "Text",ExpressionUUID->"eb37fef7-d7fa-4875-b388-b7f43feb8a14"],

Cell["\<\
A long straight line does not generally meet itself after lapping the Earth:\
\>", "Text",ExpressionUUID->"fd2fd8ae-304f-42bd-8831-fb50340fbea8"],

Cell[BoxData[
 RowBox[{"GeoGraphics", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"Red", ",", "Thick", ",", " ", 
     RowBox[{"GeoPath", "[", 
      RowBox[{"{", 
       RowBox[{
        TemplateBox[{"\"New York City\"", 
          RowBox[{"Entity", "[", 
            RowBox[{"\"City\"", ",", 
              RowBox[{"{", 
                
                RowBox[{
                 "\"NewYork\"", ",", "\"NewYork\"", ",", "\"UnitedStates\""}],
                 "}"}]}], "]"}], 
          "\"Entity[\\\"City\\\", {\\\"NewYork\\\", \\\"NewYork\\\", \
\\\"UnitedStates\\\"}]\"", "\"city\""},
         "Entity"], ",", 
        RowBox[{"GeoDisplacement", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            TemplateBox[{"\"Earth\"", 
              RowBox[{"Entity", "[", 
                RowBox[{"\"Planet\"", ",", "\"Earth\""}], "]"}], 
              "\"Entity[\\\"Planet\\\", \\\"Earth\\\"]\"", "\"planet\""},
             "Entity"], "[", 
            TemplateBox[{"\"equatorial circumference\"", 
              RowBox[{"EntityProperty", "[", 
                RowBox[{"\"Planet\"", ",", "\"EquatorialCircumference\""}], 
                "]"}], "\"EntityProperty[\\\"Planet\\\", \
\\\"EquatorialCircumference\\\"]\""},
             "EntityProperty"], "]"}], ",", "\"\<SW\>\""}], "}"}], "]"}]}], 
       "}"}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GeoCenter", "\[Rule]", 
    TemplateBox[{"\"New York City\"", 
      RowBox[{"Entity", "[", 
        RowBox[{"\"City\"", ",", 
          RowBox[{"{", 
            
            RowBox[{"\"NewYork\"", ",", "\"NewYork\"", ",", 
              "\"UnitedStates\""}], "}"}]}], "]"}], 
      "\"Entity[\\\"City\\\", {\\\"NewYork\\\", \\\"NewYork\\\", \
\\\"UnitedStates\\\"}]\"", "\"city\""},
     "Entity"]}], ",", "\[IndentingNewLine]", 
   RowBox[{"GeoRange", "\[Rule]", 
    TemplateBox[{"250", "\"km\"", "kilometers", "\"Kilometers\""},
     "Quantity"]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[55]:=",ExpressionUUID->"f04728d6-c37e-418f-8267-647a06510a54"],

Cell["\<\
However, if you assume that the Earth is a sphere, then it does:\
\>", "Text",ExpressionUUID->"a140e072-ff0e-42c3-87af-484c8c4e235a"],

Cell[BoxData[
 RowBox[{"GeoGraphics", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"Red", ",", "Thick", ",", " ", 
     RowBox[{"GeoPath", "[", 
      RowBox[{"{", 
       RowBox[{
        TemplateBox[{"\"New York City\"", 
          RowBox[{"Entity", "[", 
            RowBox[{"\"City\"", ",", 
              RowBox[{"{", 
                
                RowBox[{
                 "\"NewYork\"", ",", "\"NewYork\"", ",", "\"UnitedStates\""}],
                 "}"}]}], "]"}], 
          "\"Entity[\\\"City\\\", {\\\"NewYork\\\", \\\"NewYork\\\", \
\\\"UnitedStates\\\"}]\"", "\"city\""},
         "Entity"], ",", 
        RowBox[{"GeoDisplacement", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            TemplateBox[{"\"Earth\"", 
              RowBox[{"Entity", "[", 
                RowBox[{"\"Planet\"", ",", "\"Earth\""}], "]"}], 
              "\"Entity[\\\"Planet\\\", \\\"Earth\\\"]\"", "\"planet\""},
             "Entity"], "[", 
            TemplateBox[{"\"equatorial circumference\"", 
              RowBox[{"EntityProperty", "[", 
                RowBox[{"\"Planet\"", ",", "\"EquatorialCircumference\""}], 
                "]"}], "\"EntityProperty[\\\"Planet\\\", \
\\\"EquatorialCircumference\\\"]\""},
             "EntityProperty"], "]"}], ",", "\"\<SW\>\""}], "}"}], "]"}]}], 
       "}"}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GeoCenter", "\[Rule]", 
    TemplateBox[{"\"New York City\"", 
      RowBox[{"Entity", "[", 
        RowBox[{"\"City\"", ",", 
          RowBox[{"{", 
            
            RowBox[{"\"NewYork\"", ",", "\"NewYork\"", ",", 
              "\"UnitedStates\""}], "}"}]}], "]"}], 
      "\"Entity[\\\"City\\\", {\\\"NewYork\\\", \\\"NewYork\\\", \
\\\"UnitedStates\\\"}]\"", "\"city\""},
     "Entity"]}], ",", "\[IndentingNewLine]", 
   RowBox[{"GeoRange", "\[Rule]", 
    TemplateBox[{"250", "\"km\"", "kilometers", "\"Kilometers\""},
     "Quantity"]}], ",", "\[IndentingNewLine]", 
   RowBox[{"GeoModel", "\[Rule]", 
    RowBox[{
     TemplateBox[{"\"Earth\"", 
       RowBox[{"Entity", "[", 
         RowBox[{"\"Planet\"", ",", "\"Earth\""}], "]"}], 
       "\"Entity[\\\"Planet\\\", \\\"Earth\\\"]\"", "\"planet\""},
      "Entity"], "[", 
     TemplateBox[{"\"equatorial radius\"", 
       RowBox[{"EntityProperty", "[", 
         RowBox[{"\"Planet\"", ",", "\"EquatorialRadius\""}], "]"}], 
       "\"EntityProperty[\\\"Planet\\\", \\\"EquatorialRadius\\\"]\""},
      "EntityProperty"], "]"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[56]:=",ExpressionUUID->"5cae7678-0200-488a-88e9-961937ca185a"],

