    TemplateBox[{"\"United States\"", 
      RowBox[{"Entity", "[", 
        RowBox[{"\"Country\"", ",", "\"UnitedStates\""}], "]"}], 
      "\"Entity[\\\"Country\\\", \\\"UnitedStates\\\"]\"", "\"country\""},
     "Entity"]}], ",", "\[IndentingNewLine]", 
   RowBox[{"GeoGridLines", "\[Rule]", "Automatic"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GeoGridLinesStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{"Dashed", ",", 
      TemplateBox[<|"color" -> RGBColor[0, 0.28, 0.71]|>,
       "RGBColorSwatchTemplate"]}], "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"GeoBackground", "\[Rule]", 
    RowBox[{"Dated", "[", 
     RowBox[{"\"\<CountryBorders\>\"", ",", " ", "1700"}], "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GeoProjection", "->", "\"\<Mercator\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"StreamMarkers", "\[Rule]", "\"\<Drop\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"StreamColorFunction", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "vx", ",", "vy", ",", "n"}], "}"}], ",", 
      RowBox[{"Blend", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Green", ",", "Red"}], "}"}], ",", "x"}], "]"}]}], "]"}]}]}],
   "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"5cb5b0f1-97dc-4a04-b676-97e79c4e8ac3"],

