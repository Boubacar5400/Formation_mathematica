Cell[CellGroupData[{

Cell["Geo Primitives", "Subsubsection",
 CellChangeTimes->{{3.9525978190967464`*^9, 
  3.952597819333145*^9}},ExpressionUUID->"daeb7d7b-c416-4b10-b85b-\
b463db060942"],

Cell[TextData[{
 "There is also a set of geo primitives that can be inserted ",
 StyleBox["before",
  FontSlant->"Italic"],
 " a map projection is applied. These preserve context, but not shape."
}], "Text",ExpressionUUID->"406644b6-2f73-4a72-87dd-6c1ff8967934"],

Cell[TextData[{
 ButtonBox["GeoDisk",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/GeoDisk.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/GeoDisk.html"],
 " and ",
 ButtonBox["GeoCircle",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/GeoCircle.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/GeoCircle.html"],
 " are primitives that are round on a sphere, but not necessarily round when \
that sphere is projected onto a 2D plane:"
}], "Text",ExpressionUUID->"353bdbd5-35a1-4cfe-8b72-1bc8a7776b12"],

Cell[BoxData[
 RowBox[{"DynamicModule", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"loc1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "100"}], ",", "0"}], "}"}]}], ",", " ", 
     RowBox[{"loc2", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"100", ",", " ", "0"}], "}"}]}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"LocatorPane", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Dynamic", "[", 
      RowBox[{"{", 
       RowBox[{"loc1", ",", " ", "loc2"}], "}"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Dynamic", "@", 
      RowBox[{"GeoGraphics", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Red", ",", " ", 
          RowBox[{"GeoDisk", "[", 
           RowBox[{
            RowBox[{"Reverse", "[", "loc1", "]"}], ",", 
            TemplateBox[{"3000", "\"km\"", "kilometers", "\"Kilometers\""},
             "Quantity"]}], "]"}], ",", " ", "Blue", ",", " ", 
          RowBox[{"GeoCircle", "[", 
           RowBox[{
            RowBox[{"Reverse", "[", "loc2", "]"}], ",", 
            TemplateBox[{"3000", "\"km\"", "kilometers", "\"Kilometers\""},
             "Quantity"]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"GeoRange", "\[Rule]", "\"\<World\>\""}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GeoProjection", "->", "\"\<Equirectangular\>\""}]}], 
       "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"Appearance", "->", "None"}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.935066519232813*^9, 3.935066525854136*^9}, 
   3.935066568244417*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"bf3460f7-47b5-46ae-8ccd-ee459754f034"],

Cell[TextData[{
 "While standard primitives ",
 ButtonBox["Line",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Line.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Line.html"],
 " and ",
 ButtonBox["Arrow",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Arrow.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Arrow.html"],
 " will always give straight lines, the curvature of ",
 ButtonBox["GeoPath",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/GeoPath.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/GeoPath.html"],
 " will depend on the projection:"
}], "Text",ExpressionUUID->"41c92829-6811-4f64-92f5-34cfb1903418"],

Cell[BoxData[
 RowBox[{"GeoGraphics", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{"Red", ",", 
     RowBox[{"GeoPath", "[", 
      RowBox[{"{", 
       RowBox[{
        TemplateBox[{"\"Chicago\"", 
          RowBox[{"Entity", "[", 
            RowBox[{"\"City\"", ",", 
              RowBox[{"{", 
                
                RowBox[{
                 "\"Chicago\"", ",", "\"Illinois\"", ",", 
                  "\"UnitedStates\""}], "}"}]}], "]"}], 
          "\"Entity[\\\"City\\\", {\\\"Chicago\\\", \\\"Illinois\\\", \
\\\"UnitedStates\\\"}]\"", "\"city\""},
         "Entity"], ",", 
        TemplateBox[{"\"London\"", 
          RowBox[{"Entity", "[", 
            RowBox[{"\"City\"", ",", 
              RowBox[{"{", 
                
                RowBox[{
                 "\"London\"", ",", "\"GreaterLondon\"", ",", 
                  "\"UnitedKingdom\""}], "}"}]}], "]"}], 
          "\"Entity[\\\"City\\\", {\\\"London\\\", \\\"GreaterLondon\\\", \
\\\"UnitedKingdom\\\"}]\"", "\"city\""},
         "Entity"]}], "}"}], "]"}], ",", "\[IndentingNewLine]", "Blue", ",", 
     RowBox[{"Line", "[", 
      RowBox[{"{", 
       RowBox[{
        TemplateBox[{"\"Chicago\"", 
          RowBox[{"Entity", "[", 
            RowBox[{"\"City\"", ",", 
              RowBox[{"{", 
                
                RowBox[{
                 "\"Chicago\"", ",", "\"Illinois\"", ",", 
                  "\"UnitedStates\""}], "}"}]}], "]"}], 
          "\"Entity[\\\"City\\\", {\\\"Chicago\\\", \\\"Illinois\\\", \
\\\"UnitedStates\\\"}]\"", "\"city\""},
         "Entity"], ",", 
        TemplateBox[{"\"London\"", 
          RowBox[{"Entity", "[", 
            RowBox[{"\"City\"", ",", 
              RowBox[{"{", 
                
                RowBox[{
                 "\"London\"", ",", "\"GreaterLondon\"", ",", 
                  "\"UnitedKingdom\""}], "}"}]}], "]"}], 
          "\"Entity[\\\"City\\\", {\\\"London\\\", \\\"GreaterLondon\\\", \
\\\"UnitedKingdom\\\"}]\"", "\"city\""},
         "Entity"]}], "}"}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GeoProjection", "\[Rule]", "\"\<Mercator\>\""}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.935066586840802*^9, 3.935066592454268*^9}, {
  3.935066644189088*^9, 3.9350666707001677`*^9}, {3.935067663042512*^9, 
