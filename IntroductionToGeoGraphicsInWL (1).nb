Cell["\<\
Find magnitude 6 to 9 earthquakes around the world recorded in 2025:\
\>", "Text",
 CellChangeTimes->{{3.9803100936142483`*^9, 
  3.980310100361677*^9}},ExpressionUUID->"e19c631c-9419-4510-a13b-\
018edb9a7b5b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"earthquakeData", "=", "\[IndentingNewLine]", 
   RowBox[{"Dataset", "[", "\[IndentingNewLine]", 
    RowBox[{"EarthquakeData", "[", 
     RowBox[{"All", ",", 
      RowBox[{"{", 
       RowBox[{"6", ",", "9"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        TemplateBox[{
          RowBox[{"\"Wed 1 Jan 2025\""}], 
          RowBox[{"DateObject", "[", 
            RowBox[{
              RowBox[{"{", 
                RowBox[{"2025", ",", "1", ",", "1"}], "}"}], ",", "\"Day\""}],
             "]"}]},
         "DateObject",
         Editable->False], ",", 
        TemplateBox[{
          RowBox[{"\"Wed 31 Dec 2025\""}], 
          RowBox[{"DateObject", "[", 
            RowBox[{
              RowBox[{"{", 
                RowBox[{"2025", ",", "12", ",", "31"}], "}"}], ",", 
              "\"Day\""}], "]"}]},
         "DateObject",
         Editable->False]}], "}"}]}], "]"}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.980309791294327*^9, 3.9803098134494133`*^9}, {
  3.980310086082121*^9, 3.980310091439291*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"ddeccb16-7b34-45bd-b530-35efdefe08a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GeoBubbleChart", "[", 
  RowBox[{"Values", "[", 
   RowBox[{"earthquakeData", "[", 
    RowBox[{"All", ",", 
     RowBox[{
      RowBox[{"#Position", "->", " ", "#Magnitude"}], "&"}]}], "]"}], "]"}], 
  "]"}]], "Input",
