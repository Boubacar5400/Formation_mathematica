Cell["Relative Positions", "Subsubsection",
 CellChangeTimes->{{3.95259638543029*^9, 
  3.9525963856857147`*^9}},ExpressionUUID->"18532a54-f314-4589-89a1-\
f5facb9abdd1"],

Cell[TextData[{
 ButtonBox["GeoDestination",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/GeoDestination.html"], 
    None},
  ButtonNote->"http://reference.wolfram.com/language/ref/GeoDestination.html"],
 " and ",
 ButtonBox["GeoDisplacement",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/GeoDisplacement.html"], 
    None},
  ButtonNote->
