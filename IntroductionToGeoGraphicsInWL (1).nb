   "Prince Edward Island Canada", WolframAlphaClient`Private`boxes$$ = 
   TemplateBox[{"\"Prince Edward Island\"", 
     RowBox[{"Entity", "[", 
       RowBox[{"\"Island\"", ",", "\"PrinceEdwardIsland\""}], "]"}], 
     "\"Entity[\\\"Island\\\", \\\"PrinceEdwardIsland\\\"]\"", "\"island\""}, 
    "Entity"], 
   WolframAlphaClient`Private`allassumptions$$ = {{
    "type" -> "Clash", "word" -> "Prince Edward Island Canada", "template" -> 
     "Assuming \"Prince Edward Island Canada\" is an island${separator}Use as \
${desc} instead", "count" -> "2", "pulldown" -> "false", "default" -> 
     "{\"C\", \"Prince Edward Island Canada\"} -> {\"Island\", \"dflt\"}", 
     "Values" -> {{
       "name" -> "Island", "desc" -> "an island", "input" -> 
        "{\"C\", \"Prince Edward Island Canada\"} -> {\"Island\"}"}, {
       "name" -> "AdministrativeDivision", "desc" -> 
        "an administrative division", "input" -> 
        "{\"C\", \"Prince Edward Island Canada\"} -> \
{\"AdministrativeDivision\"}"}}}}, 
   WolframAlphaClient`Private`assumptions$$ = {}, 
   WolframAlphaClient`Private`open$$ = {1}}, 
   DynamicBox[ToBoxes[
     AlphaIntegration`LinguisticAssistantBoxes["", 1, 
      Dynamic[WolframAlphaClient`Private`query$$], 
      Dynamic[WolframAlphaClient`Private`boxes$$], 
      Dynamic[WolframAlphaClient`Private`allassumptions$$], 
