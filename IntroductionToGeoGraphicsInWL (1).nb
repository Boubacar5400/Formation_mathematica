Cell[TextData[{
 ButtonBox["FlightData",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/FlightData.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/FlightData.html"],
 " provides information on flights within the United States whose flight \
plans have been filed with the ",
 ButtonBox["FAA",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.faa.gov/"], None},
  ButtonNote->"https://www.faa.gov/"],
 "."
