Cell[CellGroupData[{

Cell["Entities", "Subsubsection",ExpressionUUID->"f7c6f484-fcb0-49f9-b13e-9c4c95cd9bd2"],

Cell["\<\
Any Entity that has a \[OpenCurlyDoubleQuote]Coordinates\
\[CloseCurlyDoubleQuote] or \[OpenCurlyDoubleQuote]Polygon\
\[CloseCurlyDoubleQuote] property can be used within GeoGraphics. These \
include \[OpenCurlyDoubleQuote]City\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]Mountain\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]Lake\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]Airport\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]Building\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]Country\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]AdministrativeDivision\[CloseCurlyDoubleQuote] and \
many more.\
\>", "Text",ExpressionUUID->"2b71b72c-7c65-4230-aea3-89db0b0aa73b"],

Cell["Get the entity for Mount Everest and check its properties:", "Text",ExpressionUUID->"361d4f1e-e35e-4121-9e00-2df9570ff9fb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"mountEverest", " ", "=", " ", 
   TemplateBox[<|
    "query" -> "mount everest", "boxes" -> TemplateBox[{"\"Mount Everest\"", 
        RowBox[{"Entity", "[", 
          RowBox[{"\"Mountain\"", ",", "\"MountEverest\""}], "]"}], 
        "\"Entity[\\\"Mountain\\\", \\\"MountEverest\\\"]\"", "\"mountain\""},
        "Entity"], "allassumptions" -> {}, "assumptions" -> {}, "open" -> {1},
      "querystate" -> {
      "Online" -> True, "Allowed" -> True, "mparse.jsp" -> 
       0.744318`6.323303515250373, "Messages" -> {}}, "contextinfo" -> 
     Automatic, "version" -> 5|>,
    "LinguisticAssistantTemplate"]}], ";"}], "\n", 
 RowBox[{"mountEverest", "[", "\"\<Properties\>\"", "]"}]}], "Input",
 CellLabel->"In[37]:=",ExpressionUUID->"93d24baa-3506-489a-a2c9-31ec9916c8a6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[{"\"administrative region\"", 
     RowBox[{"EntityProperty", "[", 
       RowBox[{"\"Mountain\"", ",", "\"AdministrativeDivision\""}], "]"}], 
     "\"EntityProperty[\\\"Mountain\\\", \\\"AdministrativeDivision\\\"]\""},
    "EntityProperty"], ",", 
   TemplateBox[{"\"alternate names\"", 
     RowBox[{"EntityProperty", "[", 
       RowBox[{"\"Mountain\"", ",", "\"AlternateNames\""}], "]"}], 
     "\"EntityProperty[\\\"Mountain\\\", \\\"AlternateNames\\\"]\""},
    "EntityProperty"], ",", 
   TemplateBox[{"\"climbing difficulty\"", 
     RowBox[{"EntityProperty", "[", 
       RowBox[{"\"Mountain\"", ",", "\"ClimbingDifficulty\""}], "]"}], 
     "\"EntityProperty[\\\"Mountain\\\", \\\"ClimbingDifficulty\\\"]\""},
    "EntityProperty"], ",", 
   TemplateBox[{"\"typical climbing months\"", 
     RowBox[{"EntityProperty", "[", 
       RowBox[{"\"Mountain\"", ",", "\"ClimbingMonths\""}], "]"}], 
     "\"EntityProperty[\\\"Mountain\\\", \\\"ClimbingMonths\\\"]\""},
    "EntityProperty"], ",", 
   TemplateBox[{"\"continent\"", 
     RowBox[{"EntityProperty", "[", 
       RowBox[{"\"Mountain\"", ",", "\"Continent\""}], "]"}], 
     "\"EntityProperty[\\\"Mountain\\\", \\\"Continent\\\"]\""},
    "EntityProperty"], ",", 
   TemplateBox[{"\"coordinates\"", 
     RowBox[{"EntityProperty", "[", 
       RowBox[{"\"Mountain\"", ",", "\"Coordinates\""}], "]"}], 
     "\"EntityProperty[\\\"Mountain\\\", \\\"Coordinates\\\"]\""},
    "EntityProperty"], ",", 
   TemplateBox[{"\"country\"", 
     RowBox[{"EntityProperty", "[", 
       RowBox[{"\"Mountain\"", ",", "\"Countries\""}], "]"}], 
     "\"EntityProperty[\\\"Mountain\\\", \\\"Countries\\\"]\""},
    "EntityProperty"], ",", 
   TemplateBox[{"\"elevation\"", 
     RowBox[{"EntityProperty", "[", 
