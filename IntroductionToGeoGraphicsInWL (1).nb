Cell["Evaluate the function at 1000 random locations in the US:", "Text",ExpressionUUID->"ff195934-3650-48dc-877c-07514bea1fb1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"reg", "=", 
   RowBox[{
    RowBox[{"Entity", "[", 
     RowBox[{"\"\<Country\>\"", ",", "\"\<UnitedStates\>\""}], "]"}], 
    "[", "\"\<Polygon\>\"", "]"}]}], ";"}], "\n", 
