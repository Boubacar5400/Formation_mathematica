 " can be used to find one position relative to another."
}], "Text",ExpressionUUID->"af793119-b5eb-4b49-952c-c62fae7773ae"],

Cell["\<\
Plot the position 1 km away from the centre of Mount Everest at a bearing of \
45\[Degree]:\
\>", "Text",
 CellChangeTimes->{{3.980311879875349*^9, 
  3.9803118802403755`*^9}},ExpressionUUID->"7073a4f1-5108-4ba4-b608-\
6c191870d621"],

Cell[BoxData[
 RowBox[{"GeoGraphics", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GeoMarker", "[", 
      TemplateBox[{"\"Mount Everest\"", 
        RowBox[{"Entity", "[", 
          RowBox[{"\"Mountain\"", ",", "\"MountEverest\""}], "]"}], 
        "\"Entity[\\\"Mountain\\\", \\\"MountEverest\\\"]\"", "\"mountain\""},
       "Entity"], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"GeoMarker", "[", 
      RowBox[{"GeoDestination", "[", 
       RowBox[{
        TemplateBox[{"\"Mount Everest\"", 
          RowBox[{"Entity", "[", 
            RowBox[{"\"Mountain\"", ",", "\"MountEverest\""}], "]"}], 
          "\"Entity[\\\"Mountain\\\", \\\"MountEverest\\\"]\"", 
          "\"mountain\""},
         "Entity"], ",", 
        RowBox[{"GeoDisplacement", "[", 
         RowBox[{"{", 
          RowBox[{
           TemplateBox[{"1"},
            "QuantityUnit",
            DisplayFunction->(TooltipBox[
              StyleBox[
               RowBox[{#, "\[InvisibleSpace]", 
                 StyleBox[
                  RowBox[{" ", "\"km\""}], "QuantityUnitTraditionalLabel"]}], 
               ShowStringCharacters -> False], "Unit: kilometers"]& ),
            InterpretationFunction->(RowBox[{"Quantity", "[", 
               RowBox[{#, ",", "\"Kilometers\""}], "]"}]& )], ",", 
           TemplateBox[{"45"},
            "QuantityUnit",
            DisplayFunction->(TooltipBox[
              StyleBox[
               RowBox[{#, "\[InvisibleSpace]", 
                 StyleBox[
                  RowBox[{"\[InvisibleSpace]", "\"\[Degree]\""}], 
                  "QuantityUnitTraditionalLabel"]}], ShowStringCharacters -> 
               False], "Unit: degrees"]& ),
            InterpretationFunction->(RowBox[{"Quantity", "[", 
               RowBox[{#, ",", "\"AngularDegrees\""}], "]"}]& )]}], "}"}], 
         "]"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GeoRange", "\[Rule]", 
    TemplateBox[{"10", "\"km\"", "kilometers", "\"Kilometers\""},
     "Quantity"]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"d5014eb3-01cc-47db-aa16-2e5e7b40158a"],

